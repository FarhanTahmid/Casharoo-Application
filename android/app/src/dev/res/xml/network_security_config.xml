<?xml version="1.0" encoding="utf-8"?>
<!-- Dev builds may reach a runserver over plain HTTP at any address the
     Server setting points to: adb reverse (localhost), the emulator's host
     alias (10.0.2.2) or a machine on the LAN. Staging and prod stay HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
